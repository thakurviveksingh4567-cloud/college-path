# ==========================================
# CollegePath Backend Environment Variables
# ==========================================

# Port (Render automatically sets PORT in production)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# Frontend Client URL (e.g. your Vercel deployment URL)
CLIENT_URL=https://college-path.vercel.app

# Database Connection (MongoDB Atlas connection string)
# Optional: If omitted or unreachable, backend runs in safe High-Performance In-Memory Demo Mode with verified sample data
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/collegepath?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=collegepath_secure_secret_key_2026_prod
